# Template `.env` — copier en `.env` (gitignoré) et adapter.
#
# Format : KEY=value (sans espace autour du =).
# Le `.env` réel est chargé automatiquement par `app.config.settings`.

# ─── Hugging Face ─────────────────────────────────────────────────────────
# Token requis UNIQUEMENT pour les modèles « gated ».
# Les modèles par défaut (e5, bge-reranker, Qdrant/bm25) sont publics.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Parsing PDF ──────────────────────────────────────────────────────────
# auto (Docling si dispo, fallback pypdf) | docling | pypdf
ECRF_PDF_PARSER_BACKEND=auto

# Post-traitement labo (structured_lab_lines) si bilan détecté
ECRF_LAB_POSTPROCESS_PDF_LAB_REPORTS=true

# Découpe max d'une section avant split (chars)
# ECRF_CHUNK_MAX_SECTION_CHARS=12000

# ─── Tests optionnels (chemins absolus locaux) ────────────────────────────
# PDF utilisateur pour test_pdf_real_files
# ECRF_TEST_PDF_PATH=

# PDF CT scan pour test_ct_scan_report_integration (placez le vôtre dans data/)
# ECRF_CT_TEST_PDF_PATH=./data/ct_scan_report_liver.pdf

# ─── Vector store ─────────────────────────────────────────────────────────
# memory (dev rapide) | qdrant (prod on-prem)
ECRF_VECTOR_BACKEND=memory

# Adapter selon votre docker-compose :
#   - 6333 : Qdrant historique (starter-kit n8n par ex.)
#   - 6533 : Qdrant rapid-flow (docker-compose.qdrant.yml ou docker-compose.dev.yml)
#   - http://qdrant:6333 : depuis le conteneur app (docker-compose.dev.yml)
ECRF_QDRANT_URL=http://localhost:6533
# ECRF_QDRANT_API_KEY=
ECRF_QDRANT_COLLECTION_PREFIX=ecrf_chunks

# ─── Embeddings denses (Hugging Face local) ───────────────────────────────
ECRF_EMBEDDING_MODEL=intfloat/multilingual-e5-base
ECRF_EMBEDDING_DIM=768
ECRF_EMBEDDING_VERSION=e5-base-v1

# ─── Hybride dense + sparse BM25 + reranker ───────────────────────────────
# Sur Python 3.14 + Windows : laisser à `false` (fastembed/ONNX crashe).
ECRF_ENABLE_SPARSE_BM25=true
ECRF_ENABLE_RERANKER=true
ECRF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ─── Extraction imagerie (LangExtract + Ollama) ───────────────────────────
# Prérequis : pip install -e ".[extraction]" et `ollama serve` + `ollama pull <model>`
# true | false — désactiver en CI/dev sans Ollama
ECRF_LANGEXTRACT_ENABLED=true
ECRF_OLLAMA_MODEL_ID=gemma2:2b
# Hôte local : http://localhost:11434
# Conteneur app (docker-compose.dev.yml) → hôte : http://host.docker.internal:11434
# Ollama conteneurisé (profile imaging) : http://ollama:11434
ECRF_OLLAMA_URL=http://localhost:11434
ECRF_OLLAMA_TIMEOUT_S=120
ECRF_LANGEXTRACT_SCHEMA_VERSION=imaging-recist-langextract-v1
# Traitement imagerie LangExtract/Ollama : chunks en parallèle (1 = séquentiel ; défaut ~8)
# ECRF_IMAGING_EXTRACTION_MAX_WORKERS=8
# Schéma d'étude JSON (champs eCRF dynamiques). Vide = data/study_schema_default.json
# ECRF_STUDY_SCHEMA_PATH=./data/study_schema_default.json

# ─── Export eCRF XLS (gabarit MA) ─────────────────────────────────────────
# Gabarit colonnes MA (une ligne = un patient). Défaut : data/MA_Base_example.xlsx
# ECRF_EXPORT_XLSX_TEMPLATE_PATH=./data/MA_Base_example.xlsx
# ECRF_EXPORT_XLS_ENABLED=true
# ECRF_EXPORT_XLS_SHEET_NAME=Global_CC
# ECRF_EXPORT_XLS_HEADER_ROW=2
# ECRF_EXPORT_XLS_PATIENT_ID_COLUMN=ID_current_base
# empty_only | always | never — empty_only saute retrieval/extraction si cellule MA déjà remplie
# ECRF_EXPORT_XLS_OVERWRITE_POLICY=empty_only
# JSON { "pipeline_patient_id": "220" } — défaut : data/patient_id_map.demo.json si présent
# ECRF_EXPORT_XLS_PATIENT_ID_MAP_PATH=./data/patient_id_map.demo.json
# ECRF_EXPORT_XLS_REQUIRE_PATIENT_IN_MA=true
# Met à jour le gabarit MA en place (source de vérité). false = copie vers outputs/ uniquement
# ECRF_EXPORT_XLS_UPDATE_MASTER_WORKBOOK=true
# Copie optionnelle du gabarit mis à jour dans outputs/<doc_id>/
# ECRF_EXPORT_XLS_MIRROR_TO_OUTPUT=false
# Alias colonnes schema → MA (défaut : data/column_aliases_ma.json)
# ECRF_EXPORT_XLS_COLUMN_ALIASES_PATH=./data/column_aliases_ma.json
# Placeholders MA = cellules vides (virgules, comparaison insensible à la casse)
# ECRF_EMPTY_SENTINELS=NA,N/A,-,A completer,A compléter,A verifier,A vérifier

# ─── Tests d'intégration (opt-in) ─────────────────────────────────────────
# Mettre à `1` pour activer le test E2E Qdrant
# ECRF_RUN_QDRANT_INTEGRATION=0
