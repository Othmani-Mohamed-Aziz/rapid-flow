# Template `.env` — copier en `.env` (gitignoré) et adapter.
#
# Format : KEY=value (sans espace autour du =).
# Le `.env` réel est chargé automatiquement par `app.config.settings`.

# ─── Hugging Face ─────────────────────────────────────────────────────────
# Token requis UNIQUEMENT pour les modèles « gated ».
# Les modèles par défaut (e5, bge-reranker, Qdrant/bm25) sont publics.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Parsing PDF ──────────────────────────────────────────────────────────
# auto (Docling si dispo, fallback pypdf) | docling | pypdf
ECRF_PDF_PARSER_BACKEND=auto

# Post-traitement labo (structured_lab_lines) si bilan détecté
ECRF_LAB_POSTPROCESS_PDF_LAB_REPORTS=true

# Découpe max d'une section avant split (chars)
# ECRF_CHUNK_MAX_SECTION_CHARS=12000

# ─── Tests optionnels (chemins absolus locaux) ────────────────────────────
# PDF utilisateur pour test_pdf_real_files
# ECRF_TEST_PDF_PATH=

# PDF CT scan pour test_ct_scan_report_integration (placez le vôtre dans data/)
# ECRF_CT_TEST_PDF_PATH=./data/ct_scan_report_liver.pdf

# ─── Vector store ─────────────────────────────────────────────────────────
# memory (dev rapide) | qdrant (prod on-prem)
ECRF_VECTOR_BACKEND=memory

# Adapter selon votre docker-compose :
#   - 6333 : Qdrant historique (starter-kit n8n par ex.)
#   - 6533 : Qdrant rapid-flow (docker-compose.qdrant.yml)
ECRF_QDRANT_URL=http://localhost:6533
# ECRF_QDRANT_API_KEY=
ECRF_QDRANT_COLLECTION_PREFIX=ecrf_chunks

# ─── Embeddings denses (Hugging Face local) ───────────────────────────────
ECRF_EMBEDDING_MODEL=intfloat/multilingual-e5-base
ECRF_EMBEDDING_DIM=768
ECRF_EMBEDDING_VERSION=e5-base-v1

# ─── Hybride dense + sparse BM25 + reranker ───────────────────────────────
# Sur Python 3.14 + Windows : laisser à `false` (fastembed/ONNX crashe).
ECRF_ENABLE_SPARSE_BM25=true
ECRF_ENABLE_RERANKER=true
ECRF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ─── Tests d'intégration (opt-in) ─────────────────────────────────────────
# Mettre à `1` pour activer le test E2E Qdrant
# ECRF_RUN_QDRANT_INTEGRATION=0
